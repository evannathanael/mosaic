# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# Model checkpoints & outputs
outputs/*
!outputs/.gitkeep
*.pt
*.pth
# ...except the small trained detector head the backend ships with (791 KB).
!combined_head.pt
*.ckpt

# Notebooks checkpoints
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Runtime upload artifacts (user-uploaded images during local runs)
backend/uploads/*
!backend/uploads/.gitkeep

# Working notes / scratch outputs
FRONTEND_IMPLEMENTATION.md
FRONTEND_REVIEW.md
plan.md
clustering_robustness_table.csv
similarity_results_sanity_check.csv

# Env
.env

# Raw datasets stay out of Git. Download or transfer them separately.
data/raw/**
!data/raw/.gitkeep

# WildFake is downloaded from ModelScope and remains local (raw images/shards).
# Keep both spellings covered because the source/repository name is WildFake.
data/raw/wildfake/**
data/raw/WildFake/**

# Commit only the approved cleaning handoff artifacts. The complete audit
# manifests remain local because they are large and are not needed for training.
data/processed/**
!data/processed/.gitkeep
!data/processed/cifake/
!data/processed/cifake/clean_manifest.csv
!data/processed/cifake/cleaning_report.json
!data/processed/cifake/near_duplicate_review.csv
!data/processed/cifake/rejected.csv
!data/processed/sid_set/
!data/processed/sid_set/clean_manifest.csv
!data/processed/sid_set/cleaning_report.json
!data/processed/sid_set/near_duplicate_review.csv
!data/processed/sid_set/rejected.csv
!data/processed/wildfake/
!data/processed/wildfake/clean_manifest.csv
!data/processed/wildfake/cleaning_report.json
!data/processed/wildfake/near_duplicate_review.csv
!data/processed/wildfake/rejected.csv
data/near_duplicates_hires/
data/near_duplicates_sid/
