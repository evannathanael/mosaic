# Copy this file to .env and fill in values from Supabase Dashboard -> Settings -> API.
# Keep the service-role key server-side; never expose it in frontend code.
SUPABASE_URL=https://your-project.supabase.co
# New Supabase API key. The older SUPABASE_SERVICE_ROLE_KEY is also accepted.
SUPABASE_SECRET_KEY=your-server-only-secret-key
SUPABASE_STORAGE_BUCKET=mosaic-images
